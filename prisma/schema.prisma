// TỰ SINH bởi scripts/gen-schema.mjs — không sửa tay. Chạy: npm run gen:schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Nhân sự — bản đồng bộ từ Google Sheet nhân sự (mã đăng nhập chỉ lưu dạng mã hoá).
model Staff {
  id        String   @id @default(cuid())
  maNV      String   @default("")
  hoTen     String
  email     String   @default("")
  chucVu    String   @default("")
  phongBan  String   @default("")
  tinhTrang String   @default("")
  codeHash  String   @default("")
  pos       Int      @default(0)
  nguon     String   @default("sheet") // sheet | seed
  updatedAt DateTime @updatedAt
  @@index([codeHash])
}

/// Thay cho Script Properties của Apps Script (Telegram, khoá làm trắng…).
model AppProperty {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Tab APP_DU_AN
model T_projects {
  rid Int @id @default(autoincrement())
  pos Int @default(0)
  id String @default("")
  tenDuAn String @default("")
  moTa String @default("")
  createdAt String @default("")
  updatedAt String @default("")
  createdBy String @default("")
  @@index([pos])
  @@map("app_du_an")
}

